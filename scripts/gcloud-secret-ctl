#!/usr/bin/env bash
#
# Talk to the gcloud-secret plugin's socket directly.
#
# Docker only ever calls the plugin's GetSecret route, so provisioning a secret
# is not something `docker secret create` can do -- it writes a name and labels
# into the swarm's raft store without consulting the driver at all. This script
# calls the plugin's own CreateSecret route instead, which means the secret is
# written to Secret Manager using the credentials the plugin already holds. No
# GCP credentials are needed wherever you are sitting; root on a node where the
# plugin is installed is.
#
#   gcloud-secret-ctl create api-key --generate 32
#   gcloud-secret-ctl create api-key --value-file ./key.txt
#   printf 'hunter2' | gcloud-secret-ctl create api-key --value-file -
#   gcloud-secret-ctl create api-key --generate 32 --label gcloud.project=other
#   gcloud-secret-ctl get api-key
#
# Requires: curl, jq, and read access to the plugin socket.
#
set -euo pipefail

PLUGIN=${PLUGIN:-glabservices/gcloud-secret}
DOCKER=${DOCKER:-docker}

usage() {
	sed -n '3,20p' "$0" | sed 's/^# \?//'
	exit "${1:-0}"
}

die() { echo "error: $*" >&2; exit 1; }

# socket_for locates the unix socket of the installed plugin. The id changes on
# every reinstall, so it is looked up rather than remembered.
socket_for() {
	local id
	id=$($DOCKER plugin inspect "$PLUGIN" -f '{{.Id}}' 2>/dev/null) \
		|| die "plugin $PLUGIN is not installed (override with PLUGIN=...)"
	local sock="/run/docker/plugins/$id/secret-gcloud.sock"
	[ -S "$sock" ] || die "plugin $PLUGIN is installed but not enabled: no socket at $sock"
	echo "$sock"
}

call() {
	local sock=$1 path=$2 body=$3
	curl -s --max-time 120 --unix-socket "$sock" \
		-H 'Content-Type: application/json' -d "$body" "http://localhost$path"
}

# report prints the plugin's answer and exits non-zero if it was an error, so
# this is usable in a script without parsing anything.
report() {
	local reply=$1
	local err
	err=$(printf '%s' "$reply" | jq -r '.Err // empty')
	if [ -n "$err" ]; then
		echo "error: $err" >&2
		exit 1
	fi
	printf '%s' "$reply" | jq -r '. | del(.Err)'
}

cmd_create() {
	local name=${1:-}; shift || true
	[ -n "$name" ] || die "create needs a secret name"

	local value="" value_set=0 generate=0 if_missing=false
	local labels='{}'

	while [ $# -gt 0 ]; do
		case "$1" in
			--generate)   generate=${2:?--generate needs a byte count}; shift 2 ;;
			--value)      value=${2:?--value needs a value}; value_set=1; shift 2 ;;
			--value-file)
				local f=${2:?--value-file needs a path}
				if [ "$f" = "-" ]; then value=$(cat); else value=$(cat "$f"); fi
				value_set=1; shift 2 ;;
			--label)
				local kv=${2:?--label needs key=value}
				labels=$(printf '%s' "$labels" | jq --arg k "${kv%%=*}" --arg v "${kv#*=}" '.[$k]=$v')
				shift 2 ;;
			--if-missing) if_missing=true; shift ;;
			-h|--help)    usage 0 ;;
			*)            die "unknown option: $1" ;;
		esac
	done

	[ "$value_set" -eq 1 ] || [ "$generate" -gt 0 ] \
		|| die "give --value, --value-file, or --generate"

	# Value is []byte on the wire, which Go decodes from base64.
	local body
	body=$(jq -nc \
		--arg name "$name" \
		--argjson labels "$labels" \
		--argjson generate "$generate" \
		--argjson ifmissing "$if_missing" \
		--arg value "$(printf '%s' "$value" | base64 -w0)" \
		--argjson valueset "$value_set" \
		'{SecretName:$name, SecretLabels:$labels, IfMissing:$ifmissing}
		 | if $valueset == 1 then .Value = $value else .Generate = $generate end')

	local sock; sock=$(socket_for)
	report "$(call "$sock" /SecretProvider.CreateSecret "$body")"
}

cmd_get() {
	local name=${1:-}; shift || true
	[ -n "$name" ] || die "get needs a secret name"

	local labels='{}'
	while [ $# -gt 0 ]; do
		case "$1" in
			--label)
				local kv=${2:?--label needs key=value}
				labels=$(printf '%s' "$labels" | jq --arg k "${kv%%=*}" --arg v "${kv#*=}" '.[$k]=$v')
				shift 2 ;;
			-h|--help) usage 0 ;;
			*)         die "unknown option: $1" ;;
		esac
	done

	local body sock reply
	body=$(jq -nc --arg name "$name" --argjson labels "$labels" \
		'{SecretName:$name, SecretLabels:$labels}')
	sock=$(socket_for)
	reply=$(call "$sock" /SecretProvider.GetSecret "$body")

	local err
	err=$(printf '%s' "$reply" | jq -r '.Err // empty')
	[ -z "$err" ] || { echo "error: $err" >&2; exit 1; }
	printf '%s' "$reply" | jq -r '.Value' | base64 -d
}

command -v jq >/dev/null || die "jq is required"
command -v curl >/dev/null || die "curl is required"

case "${1:-}" in
	create) shift; cmd_create "$@" ;;
	get)    shift; cmd_get "$@" ;;
	-h|--help|"") usage 0 ;;
	*)      die "unknown command: $1 (try create or get)" ;;
esac
